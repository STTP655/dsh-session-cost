{
  "name": "dsh-session-cost",
  "version": "0.1.3-custom.1",
  "description": "显示当前会话的 DeepSeek API 费用估算：底部统计条给出费用与当前峰谷档位（峰价红 / 谷价绿），会话标题旁的「费用」按钮打开详情面板——24 小时柱状图、逐小时明细与按天归档；费用按峰谷分时段记账，内置 2026 年法定节假日。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "README.md",
    "docs"
  ],
  "license": "MIT",
  "author": "ChengChe106",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChengChe106/dsh-session-cost.git"
  },
  "homepage": "https://github.com/ChengChe106/dsh-session-cost",
  "bugs": {
    "url": "https://github.com/ChengChe106/dsh-session-cost/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "client",
    "cost",
    "token",
    "billing",
    "pricing"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "react": "^18.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6",
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
